---
/**
 * Interactive scaling calculator that lets readers adjust inputs
 * and see how Skipper's HPA-inspired autoscaler responds.
 */
---

<div class="scaling-calculator">
  <div class="calc-section">
    <div class="calc-section-header">Inputs</div>
    <div class="calc-inputs">
      <div class="calc-field">
        <label for="calc-instances">Instances</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-instances" min="1" max="20" value="5" />
          <output for="calc-instances" id="calc-instances-val" aria-live="polite">5</output>
        </div>
      </div>
      <div class="calc-field">
        <label for="calc-total-cpu">Total CPU (millicores)</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-total-cpu" min="0" max="8000" step="50" value="1050" />
          <output for="calc-total-cpu" id="calc-total-cpu-val" aria-live="polite">1050m</output>
        </div>
      </div>
      <div class="calc-field">
        <label for="calc-target">Target per instance (millicores)</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-target" min="50" max="2000" step="50" value="200" />
          <output for="calc-target" id="calc-target-val" aria-live="polite">200m</output>
        </div>
      </div>
      <div class="calc-field">
        <label for="calc-tolerance">Tolerance</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-tolerance" min="0" max="0.5" step="0.01" value="0.1" />
          <output for="calc-tolerance" id="calc-tolerance-val" aria-live="polite">0.10</output>
        </div>
      </div>
    </div>
  </div>

  <div class="calc-section">
    <div class="calc-section-header">Calculation</div>
    <div class="calc-output" id="calc-result" aria-live="polite" aria-atomic="true">
      <!-- filled by JS -->
    </div>
  </div>
</div>

<style>
  .scaling-calculator {
    --calc-color-over: #f97583;
    --calc-color-under: #79c0ff;

    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-block: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .calc-section-header {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
  }

  .calc-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.25rem;
  }

  @media (max-width: 40rem) {
    .calc-inputs {
      grid-template-columns: 1fr;
    }
  }

  .calc-field {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .calc-field label {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 0.15rem;
    color: var(--sl-color-text);
  }

  .calc-slider-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .calc-slider-row input[type="range"] {
    flex: 1;
    min-width: 0;
    accent-color: var(--sl-color-accent-high, var(--sl-color-text-accent));
  }

  .calc-slider-row output {
    width: 3.5rem;
    flex-shrink: 0;
    text-align: right;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-text);
  }

  .calc-output {
    font-size: 0.85rem;
  }

  .calc-output :global(.calc-step) {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  .calc-output :global(.calc-step:last-of-type) {
    border-bottom: none;
  }

  .calc-output :global(.calc-step-main) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .calc-output :global(.calc-label) {
    color: var(--sl-color-text);
    font-weight: 500;
    flex-shrink: 0;
    font-size: 0.8rem;
  }

  .calc-output :global(.calc-value) {
    text-align: right;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
  }

  .calc-output :global(.calc-hint) {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.1rem;
  }

  .calc-output :global(.calc-bar-track) {
    height: 4px;
    background: var(--sl-color-hairline-light);
    border-radius: 2px;
    margin-top: 0.3rem;
    overflow: hidden;
  }

  .calc-output :global(.calc-bar-fill) {
    height: 100%;
    border-radius: 2px;
    transition: width 0.15s ease, background-color 0.15s ease;
  }

  .calc-output :global(.calc-verdict) {
    margin-top: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.375rem;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .calc-output :global(.calc-verdict.no-change) {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6, rgba(128, 128, 128, 0.08));
  }
  .calc-output :global(.calc-verdict.scale-up) {
    color: var(--calc-color-over);
    background: rgba(249, 117, 131, 0.08);
  }
  .calc-output :global(.calc-verdict.scale-down) {
    color: var(--calc-color-under);
    background: rgba(121, 192, 255, 0.08);
  }
</style>

<script>
  function setup(): void {
    const instances = document.getElementById("calc-instances") as HTMLInputElement;
    const totalCpu = document.getElementById("calc-total-cpu") as HTMLInputElement;
    const target = document.getElementById("calc-target") as HTMLInputElement;
    const tolerance = document.getElementById("calc-tolerance") as HTMLInputElement;
    const result = document.getElementById("calc-result")!;

    const valInstances = document.getElementById("calc-instances-val")!;
    const valTotalCpu = document.getElementById("calc-total-cpu-val")!;
    const valTarget = document.getElementById("calc-target-val")!;
    const valTolerance = document.getElementById("calc-tolerance-val")!;

    const COLOR_OVER = "var(--calc-color-over)";
    const COLOR_UNDER = "var(--calc-color-under)";
    const COLOR_NEAR = "var(--sl-color-accent-high, var(--sl-color-text-accent))";

    function barColor(ratio: number): string {
      if (ratio > 1.15) return COLOR_OVER;
      if (ratio > 0.85) return COLOR_NEAR;
      return COLOR_UNDER;
    }

    function update(): void {
      const n = Number(instances.value);
      const cpu = Number(totalCpu.value);
      const t = Number(target.value);
      const tol = Number(tolerance.value);

      valInstances.textContent = String(n);
      valTotalCpu.textContent = cpu + "m";
      valTarget.textContent = t + "m";
      valTolerance.textContent = tol.toFixed(2);

      const avg = cpu / n;
      const ratio = avg / t;
      const diff = Math.abs(ratio - 1.0);
      const pct = ratio * 100;
      const pctDisplay = pct % 1 === 0 ? pct.toFixed(0) : pct.toFixed(1);
      const diffDisplay = (diff * 100) % 1 === 0 ? (diff * 100).toFixed(0) : (diff * 100).toFixed(1);
      const tolDisplay = (tol * 100) % 1 === 0 ? (tol * 100).toFixed(0) : (tol * 100).toFixed(1);

      const tolPass = diff <= tol;
      const desired = tolPass ? n : Math.max(1, Math.ceil(n * ratio));

      let verdict: string;
      let verdictClass: string;

      if (tolPass) {
        verdict = `no change — ${n} instances (within tolerance)`;
        verdictClass = "no-change";
      } else if (desired === n) {
        verdict = `no change — ${n} instances (ratio within rounding)`;
        verdictClass = "no-change";
      } else if (ratio > 1.0) {
        verdict = `scale up: ${n} → ${desired} instances (+${desired - n})`;
        verdictClass = "scale-up";
      } else {
        verdict = `scale down: ${n} → ${desired} instances (−${n - desired})`;
        verdictClass = "scale-down";
      }

      const barPct = Math.min(Math.round(pct), 200);

      const step4 = tolPass
        ? `<div class="calc-step">` +
            `<div class="calc-step-main">` +
              `<span class="calc-label">Desired instances</span>` +
              `<span class="calc-value">${n} (unchanged)</span>` +
            `</div>` +
            `<div class="calc-hint">Within tolerance — scaling suppressed</div>` +
          `</div>`
        : `<div class="calc-step">` +
            `<div class="calc-step-main">` +
              `<span class="calc-label">Desired instances</span>` +
              `<span class="calc-value">⌈${n} × ${pctDisplay}%⌉ = ${desired}</span>` +
            `</div>` +
            `<div class="calc-hint">${pctDisplay}% utilization means ${pctDisplay}% of ${n} instances are needed</div>` +
          `</div>`;

      result.innerHTML = [
        `<div class="calc-step">` +
          `<div class="calc-step-main">` +
            `<span class="calc-label">Average usage</span>` +
            `<span class="calc-value">${cpu}m ÷ ${n} = ${avg.toFixed(0)}m</span>` +
          `</div>` +
          `<div class="calc-hint">Each instance averages ${avg.toFixed(0)}m CPU</div>` +
        `</div>`,

        `<div class="calc-step">` +
          `<div class="calc-step-main">` +
            `<span class="calc-label">Usage ratio</span>` +
            `<span class="calc-value">${avg.toFixed(0)}m ÷ ${t}m = ${pctDisplay}%</span>` +
          `</div>` +
          `<div class="calc-hint">Instances are at ${pctDisplay}% of their ${t}m target</div>` +
          `<div class="calc-bar-track">` +
            `<div class="calc-bar-fill" style="width: ${barPct / 2}%; background: ${barColor(ratio)}"></div>` +
          `</div>` +
        `</div>`,

        `<div class="calc-step">` +
          `<div class="calc-step-main">` +
            `<span class="calc-label">Within tolerance?</span>` +
            `<span class="calc-value">|100% − ${pctDisplay}%| = ${diffDisplay}% ${tolPass ? "≤" : ">"} ${tolDisplay}% ${tolPass ? "✓" : "✗"}</span>` +
          `</div>` +
          `<div class="calc-hint">${tolPass ? "Close enough to the target — no scaling needed" : "Too far from target — scaling required"}</div>` +
        `</div>`,

        step4,

        `<div class="calc-verdict ${verdictClass}">→ ${verdict}</div>`,
      ].join("");
    }

    instances.addEventListener("input", update);
    totalCpu.addEventListener("input", update);
    target.addEventListener("input", update);
    tolerance.addEventListener("input", update);
    update();
  }

  setup();
</script>
