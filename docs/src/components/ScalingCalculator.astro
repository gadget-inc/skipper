---
/**
 * Interactive scaling calculator that lets readers adjust inputs
 * and see how Skipper's HPA-inspired autoscaler responds.
 */
---

<div class="scaling-calculator">
  <div class="calc-inputs">
    <div class="calc-field">
      <label for="calc-instances">Current instances</label>
      <div class="calc-slider-row">
        <input type="range" id="calc-instances" min="1" max="20" value="5" />
        <output for="calc-instances" id="calc-instances-val">5</output>
      </div>
    </div>
    <div class="calc-field">
      <label for="calc-total-cpu">Total CPU across instances (millicores)</label>
      <div class="calc-slider-row">
        <input type="range" id="calc-total-cpu" min="0" max="8000" step="50" value="1050" />
        <output for="calc-total-cpu" id="calc-total-cpu-val">1050m</output>
      </div>
    </div>
    <div class="calc-field">
      <label for="calc-target">Target CPU per instance (millicores)</label>
      <div class="calc-slider-row">
        <input type="range" id="calc-target" min="50" max="2000" step="50" value="200" />
        <output for="calc-target" id="calc-target-val">200m</output>
      </div>
    </div>
    <div class="calc-field">
      <label for="calc-tolerance">Tolerance</label>
      <div class="calc-slider-row">
        <input type="range" id="calc-tolerance" min="0" max="0.5" step="0.01" value="0.1" />
        <output for="calc-tolerance" id="calc-tolerance-val">0.10</output>
      </div>
    </div>
  </div>

  <div class="calc-output" id="calc-result">
    <!-- filled by JS -->
  </div>
</div>

<style>
  .scaling-calculator {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-block: 1rem;
  }

  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .calc-field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    color: var(--sl-color-text);
  }

  .calc-slider-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .calc-slider-row input[type="range"] {
    flex: 1;
    accent-color: var(--sl-color-accent-high, var(--sl-color-text-accent));
  }

  .calc-slider-row output {
    min-width: 4.5rem;
    text-align: right;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--sl-color-text);
  }

  .calc-output {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    white-space: pre-line;
    background: var(--sl-color-bg-inline-code, rgba(255, 255, 255, 0.08));
  }

  .calc-verdict {
    display: inline-block;
    margin-top: 0.25rem;
    font-weight: 600;
  }
  .calc-verdict.no-change { color: var(--sl-color-text); }
  .calc-verdict.scale-up { color: #f97583; }
  .calc-verdict.scale-down { color: #79c0ff; }
</style>

<script>
  function setup() {
    const instances = document.getElementById("calc-instances") as HTMLInputElement;
    const totalCpu = document.getElementById("calc-total-cpu") as HTMLInputElement;
    const target = document.getElementById("calc-target") as HTMLInputElement;
    const tolerance = document.getElementById("calc-tolerance") as HTMLInputElement;
    const result = document.getElementById("calc-result")!;

    const valInstances = document.getElementById("calc-instances-val")!;
    const valTotalCpu = document.getElementById("calc-total-cpu-val")!;
    const valTarget = document.getElementById("calc-target-val")!;
    const valTolerance = document.getElementById("calc-tolerance-val")!;

    function update() {
      const n = Number(instances.value);
      const cpu = Number(totalCpu.value);
      const t = Number(target.value);
      const tol = Number(tolerance.value);

      valInstances.textContent = String(n);
      valTotalCpu.textContent = cpu + "m";
      valTarget.textContent = t + "m";
      valTolerance.textContent = tol.toFixed(2);

      const avg = cpu / n;
      const ratio = avg / t;
      const diff = Math.abs(ratio - 1.0);

      let verdict: string;
      let verdictClass: string;
      let desired: string;

      if (diff <= tol) {
        verdict = "no change (within tolerance)";
        verdictClass = "no-change";
        desired = String(n);
      } else if (ratio > 1.0) {
        const d = Math.ceil(n * ratio);
        verdict = "scale up";
        verdictClass = "scale-up";
        desired = String(d);
      } else {
        const d = Math.ceil(n * ratio);
        verdict = "scale down";
        verdictClass = "scale-down";
        desired = String(d);
      }

      result.innerHTML =
        `average  = ${cpu}m / ${n} = ${avg.toFixed(0)}m\n` +
        `ratio    = ${avg.toFixed(0)}m / ${t}m = ${ratio.toFixed(3)}\n` +
        `|${ratio.toFixed(3)} − 1.0| = ${diff.toFixed(3)} ${diff <= tol ? "≤" : ">"} ${tol.toFixed(2)} (tolerance)\n` +
        `desired  = ⌈${n} × ${ratio.toFixed(3)}⌉ = ${desired} instances\n` +
        `<span class="calc-verdict ${verdictClass}">→ ${verdict}</span>`;
    }

    instances.addEventListener("input", update);
    totalCpu.addEventListener("input", update);
    target.addEventListener("input", update);
    tolerance.addEventListener("input", update);
    update();
  }

  setup();
</script>
