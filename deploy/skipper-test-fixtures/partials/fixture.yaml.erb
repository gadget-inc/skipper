<%-
env ||= {}
image = "skipper-fixtures-#{name}:#{image_tag}"
unless image_digest.empty?
  image += "@#{image_digest}"
end
-%>
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= name %>
  labels:
    skipper/deployment: <%= name %>
  annotations:
    shipit.shopify.io/restart: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      skipper/deployment: <%= name %>
    matchExpressions:
      - key: skipper/tenant
        operator: DoesNotExist
  template:
    metadata:
      labels:
        skipper/deployment: <%= name %>
      annotations:
        skipper/port: "http"
    spec:
      volumes:
        - name: empty-dir
          emptyDir: {}
      containers:
        - name: <%= name %>
          image: <%= image %>
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 8888
          env:
            - name: SKIPPER_PUBLIC_KEY
              value: <%= File.read("#{workspace_dir}/tmp/paseto/public.pem").to_json %>
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
          volumeMounts:
            - name: empty-dir
              mountPath: /tmp
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "256Mi"
              cpu: "250m"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
