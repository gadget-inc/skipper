---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: fusion-router
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fusion-router
  labels:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: router
  annotations:
    shipit.shopify.io/restart: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: fusion
      app.kubernetes.io/component: router
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fusion
        app.kubernetes.io/component: router
    spec:
      serviceAccountName: fusion-router
      containers:
        - name: router
          image: fusion:<%= image_tag %>
          imagePullPolicy: Never
          args:
            - router
            - --log-level=debug
            - --log-format=text
          ports:
            - name: http-port
              containerPort: 8080
          env:
            - name: GOMAXPROCS
              valueFrom:
                resourceFieldRef:
                  resource: requests.cpu
            - name: GOMEMLIMIT
              valueFrom:
                resourceFieldRef:
                  resource: requests.memory
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          startupProbe:
            httpGet:
              path: /healthz
              port: http-port
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http-port
            failureThreshold: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http-port
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
---
apiVersion: v1
kind: Service
metadata:
  name: fusion-router
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: router
  ports:
    - port: 80
      nodePort: 31020
      targetPort: http-port
