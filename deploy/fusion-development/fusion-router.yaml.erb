---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: fusion-router
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: fusion-router
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: fusion-router
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: fusion-router
subjects:
  - kind: ServiceAccount
    name: fusion-router
    namespace: fusion-development
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fusion-router
  labels:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: router
  annotations:
    shipit.shopify.io/restart: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: fusion
      app.kubernetes.io/component: router
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fusion
        app.kubernetes.io/component: router
    spec:
      serviceAccountName: fusion-router
      containers:
        - name: router
          image: fusion:<%= imageTag %>
          imagePullPolicy: Never
          args: ["router"]
          ports:
            - name: http-port
              containerPort: 8080
          env:
            - name: FUSION_FUNCTION_NAMESPACES
              value: "example-development,gadget-app-sandbox-development,gadget-app-sandbox-test"
            - name: FUSION_CONTROLLER_SERVICE_HOST
              value: "fusion-controller.fusion-development.svc"
            - name: FUSION_CONTROLLER_SERVICE_PORT
              value: "80"
            - name: FUSION_LOG_LEVEL
              value: "debug"
            - name: FUSION_LOG_FORMAT
              value: "text"
            - name: GOMAXPROCS
              value: "1"
            - name: GOMEMLIMIT
              value: "256MiB"
          resources:
            limits:
              memory: "512Mi"
              cpu: "500m"
            requests:
              memory: "256Mi"
              cpu: "250m"
          startupProbe:
            httpGet:
              path: /healthz
              port: http-port
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http-port
            failureThreshold: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http-port
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
---
apiVersion: v1
kind: Service
metadata:
  name: fusion-router
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: router
  ports:
    - port: 80
      nodePort: 31315
      targetPort: http-port
