<%-
extra_env = locals[:extra_env] || {}
-%>
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= name %>
  labels:
    fusion/deployment: <%= name %>
  annotations:
    shipit.shopify.io/restart: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      fusion/deployment: <%= name %>
    matchExpressions:
      - key: fusion/tenant
        operator: DoesNotExist
  template:
    metadata:
      labels:
        fusion/deployment: <%= name %>
      annotations:
        fusion/port: "http"
    spec:
      volumes:
        - name: empty-dir
          emptyDir: {}
      containers:
        - name: <%= name %>
          image: fusion-fixtures-<%= name %>:latest
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 8888
          env:
            - name: FUSION_PUBLIC_KEY
              value: <%= File.read("#{workspace_dir}/tmp/paseto/public.pem").to_json %>
            <%- extra_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
          volumeMounts:
            - name: empty-dir
              mountPath: /tmp
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "256Mi"
              cpu: "250m"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
