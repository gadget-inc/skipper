<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Scaling - Skipper</title>
<meta name="description" content="Interactive scaling calculator." />
<link rel="stylesheet" href="/skipper/style.css" />
</head>
<body>
<div class="layout">
<nav class="sidebar" aria-label="Site navigation"><ul class="sidebar-top">
  <li><a href="/skipper/">Introduction</a></li>
</ul>
<details class="sidebar-group" open>
  <summary>Guides</summary>
  <ul>
    <li><a href="/skipper/guides/routing/">Routing</a></li>
    <li><a href="/skipper/guides/scaling/">Scaling</a></li>
  </ul>
</details>
<details class="sidebar-group" open>
  <summary>Architecture</summary>
  <ul>
    <li><a href="/skipper/architecture/overview/">Overview</a></li>
  </ul>
</details>
<details class="sidebar-group" open>
  <summary>Reference</summary>
  <ul>
    <li><a href="/skipper/reference/api/">API</a></li>
  </ul>
</details>
<details class="sidebar-group" open>
  <summary>Contributing</summary>
  <ul>
    <li><a href="/skipper/contributing/workflow/">Workflow</a></li>
  </ul>
</details>
</nav>
<main class="content">
<h1>Scaling</h1>
<p>The calculator below illustrates the scaling math.</p>

<div class="scaling-calculator">
  <div class="calc-section">
    <div class="calc-section-header">Inputs</div>
    <div class="calc-inputs">
      <div class="calc-field">
        <label for="calc-instances">Instances</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-instances" min="1" max="20" value="5" />
          <output for="calc-instances" id="calc-instances-val" aria-live="polite">5</output>
        </div>
      </div>
      <div class="calc-field">
        <label for="calc-total-cpu">Total CPU (millicores)</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-total-cpu" min="0" max="8000" step="50" value="1050" />
          <output for="calc-total-cpu" id="calc-total-cpu-val" aria-live="polite">1050m</output>
        </div>
      </div>
      <div class="calc-field">
        <label for="calc-target">Target per instance (millicores)</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-target" min="50" max="2000" step="50" value="200" />
          <output for="calc-target" id="calc-target-val" aria-live="polite">200m</output>
        </div>
      </div>
      <div class="calc-field">
        <label for="calc-tolerance">Tolerance</label>
        <div class="calc-slider-row">
          <input type="range" id="calc-tolerance" min="0" max="0.5" step="0.01" value="0.1" />
          <output for="calc-tolerance" id="calc-tolerance-val" aria-live="polite">0.10</output>
        </div>
      </div>
    </div>
  </div>

  <div class="calc-section">
    <div class="calc-section-header">Calculation</div>
    <div class="calc-output" id="calc-result" aria-live="polite" aria-atomic="true"></div>
  </div>
</div>

<style>
.scaling-calculator {
  --calc-color-over: #f97583;
  --calc-color-under: #79c0ff;
  border: 1px solid var(--border-color, #d1d9e0);
  border-radius: 0.5rem;
  padding: 1rem 1.25rem;
  margin-block: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.scaling-calculator .calc-section-header {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted, #59636e);
  margin-bottom: 0.5rem;
}
.scaling-calculator .calc-inputs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem 1.25rem;
}
@media (max-width: 40rem) {
  .scaling-calculator .calc-inputs { grid-template-columns: 1fr; }
}
.scaling-calculator .calc-field { display: flex; flex-direction: column; justify-content: flex-end; }
.scaling-calculator .calc-field label {
  display: block;
  font-size: 0.8rem;
  font-weight: 500;
  margin-bottom: 0.15rem;
}
.scaling-calculator .calc-slider-row { display: flex; align-items: center; gap: 0.35rem; }
.scaling-calculator .calc-slider-row input[type="range"] { flex: 1; min-width: 0; accent-color: var(--accent-color, #0969da); }
.scaling-calculator .calc-slider-row output {
  width: 3.5rem;
  flex-shrink: 0;
  text-align: right;
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 0.8rem;
}
.scaling-calculator .calc-output { font-size: 0.85rem; }
.scaling-calculator .calc-step {
  padding: 0.3rem 0;
  border-bottom: 1px solid var(--border-color, #d1d9e0);
}
.scaling-calculator .calc-step:last-of-type { border-bottom: none; }
.scaling-calculator .calc-step-main { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
.scaling-calculator .calc-label { font-weight: 500; flex-shrink: 0; font-size: 0.8rem; }
.scaling-calculator .calc-value {
  text-align: right;
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 0.8rem;
}
.scaling-calculator .calc-hint { font-size: 0.75rem; color: var(--text-muted, #59636e); margin-top: 0.1rem; }
.scaling-calculator .calc-bar-track {
  height: 4px;
  background: var(--border-color, #d1d9e0);
  border-radius: 2px;
  margin-top: 0.3rem;
  overflow: hidden;
}
.scaling-calculator .calc-bar-fill { height: 100%; border-radius: 2px; transition: width 0.15s ease, background-color 0.15s ease; }
.scaling-calculator .calc-verdict {
  margin-top: 0.5rem;
  padding: 0.4rem 0.6rem;
  border-radius: 0.375rem;
  font-weight: 600;
  font-size: 0.85rem;
}
.scaling-calculator .calc-verdict.no-change { background: rgba(128, 128, 128, 0.08); }
.scaling-calculator .calc-verdict.scale-up { color: var(--calc-color-over); background: rgba(249, 117, 131, 0.08); }
.scaling-calculator .calc-verdict.scale-down { color: var(--calc-color-under); background: rgba(121, 192, 255, 0.08); }
</style>

<script>
(function () {
  var instances = document.getElementById("calc-instances");
  var totalCpu = document.getElementById("calc-total-cpu");
  var target = document.getElementById("calc-target");
  var tolerance = document.getElementById("calc-tolerance");
  var result = document.getElementById("calc-result");
  if (!instances || !totalCpu || !target || !tolerance || !result) return;

  var valInstances = document.getElementById("calc-instances-val");
  var valTotalCpu = document.getElementById("calc-total-cpu-val");
  var valTarget = document.getElementById("calc-target-val");
  var valTolerance = document.getElementById("calc-tolerance-val");

  var COLOR_OVER = "var(--calc-color-over)";
  var COLOR_UNDER = "var(--calc-color-under)";
  var COLOR_NEAR = "var(--accent-color, #0969da)";

  function barColor(ratio) {
    if (ratio > 1.15) return COLOR_OVER;
    if (ratio > 0.85) return COLOR_NEAR;
    return COLOR_UNDER;
  }

  function update() {
    var n = Number(instances.value);
    var cpu = Number(totalCpu.value);
    var t = Number(target.value);
    var tol = Number(tolerance.value);

    valInstances.textContent = String(n);
    valTotalCpu.textContent = cpu + "m";
    valTarget.textContent = t + "m";
    valTolerance.textContent = tol.toFixed(2);

    var avg = cpu / n;
    var ratio = avg / t;
    var diff = Math.abs(ratio - 1.0);
    var pct = ratio * 100;
    var pctDisplay = pct % 1 === 0 ? pct.toFixed(0) : pct.toFixed(1);
    var diffDisplay = (diff * 100) % 1 === 0 ? (diff * 100).toFixed(0) : (diff * 100).toFixed(1);
    var tolDisplay = (tol * 100) % 1 === 0 ? (tol * 100).toFixed(0) : (tol * 100).toFixed(1);

    var tolPass = diff <= tol;
    var rawDesired = Math.ceil(n * ratio);
    var floorApplied = !tolPass && rawDesired < 1;
    var desired = tolPass ? n : Math.max(1, rawDesired);

    var verdict, verdictClass;
    if (tolPass) {
      verdict = "no change - " + n + " instances (within tolerance)";
      verdictClass = "no-change";
    } else if (desired === n) {
      verdict = "no change - " + n + " instances (ratio within rounding)";
      verdictClass = "no-change";
    } else if (ratio > 1.0) {
      verdict = "scale up: " + n + " -> " + desired + " instances (+" + (desired - n) + ")";
      verdictClass = "scale-up";
    } else {
      verdict = "scale down: " + n + " -> " + desired + " instances (-" + (n - desired) + ")";
      verdictClass = "scale-down";
    }

    var barPct = Math.min(Math.round(pct), 200);

    var step4 = tolPass
      ? '<div class="calc-step"><div class="calc-step-main"><span class="calc-label">Desired instances</span><span class="calc-value">' + n + " (unchanged)</span></div><div class=\"calc-hint\">Within tolerance - scaling suppressed</div></div>"
      : '<div class="calc-step"><div class="calc-step-main"><span class="calc-label">Desired instances</span><span class="calc-value">' + (floorApplied ? "max(1, ceil(" + n + " * " + pctDisplay + "%))" : "ceil(" + n + " * " + pctDisplay + "%)") + " = " + desired + "</span></div><div class=\"calc-hint\">" + (floorApplied ? "ceil rounded to 0, but at least 1 instance is required" : pctDisplay + "% utilization means " + pctDisplay + "% of " + n + " instances are needed") + "</div></div>";

    result.innerHTML = [
      '<div class="calc-step"><div class="calc-step-main"><span class="calc-label">Average usage</span><span class="calc-value">' + cpu + "m / " + n + " = " + avg.toFixed(0) + "m</span></div><div class=\"calc-hint\">Each instance averages " + avg.toFixed(0) + "m CPU</div></div>",
      '<div class="calc-step"><div class="calc-step-main"><span class="calc-label">Usage ratio</span><span class="calc-value">' + avg.toFixed(0) + "m / " + t + "m = " + pctDisplay + "%</span></div><div class=\"calc-hint\">Instances are at " + pctDisplay + "% of their " + t + "m target</div><div class=\"calc-bar-track\"><div class=\"calc-bar-fill\" style=\"width: " + barPct / 2 + "%; background: " + barColor(ratio) + "\"></div></div></div>",
      '<div class="calc-step"><div class="calc-step-main"><span class="calc-label">Within tolerance?</span><span class="calc-value">|100% - ' + pctDisplay + "%| = " + diffDisplay + "% " + (tolPass ? "<=" : ">") + " " + tolDisplay + "% " + (tolPass ? "OK" : "X") + "</span></div><div class=\"calc-hint\">" + (tolPass ? "Close enough to the target - no scaling needed" : "Too far from target - scaling required") + "</div></div>",
      step4,
      '<div class="calc-verdict ' + verdictClass + '">-> ' + verdict + "</div>",
    ].join("");
  }

  instances.addEventListener("input", update);
  totalCpu.addEventListener("input", update);
  target.addEventListener("input", update);
  tolerance.addEventListener("input", update);
  update();
})();
</script>

</main>
</div>

</body>
</html>
