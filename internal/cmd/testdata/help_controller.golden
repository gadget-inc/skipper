Start the controller

Usage:
  controller [flags]

Flags:
      --function-assign-path string             The path used to assign a function to a pod. (env SKIPPER_FUNCTION_ASSIGN_PATH) (default "/__skipper/assign")
      --function-assign-timeout duration        The timeout for assigning a function to a pod. (env SKIPPER_FUNCTION_ASSIGN_TIMEOUT) (default 30s)
      --function-namespaces strings             The namespaces where functions can be invoked. (env SKIPPER_FUNCTION_NAMESPACES)
      --hash-ring-wait-time duration            How long to wait for the controller to populate its hash ring. (env SKIPPER_HASH_RING_WAIT_TIME) (default 10s)
      --heartbeat-timeout duration              How long to wait before scaling a function to 0 if it has not sent a heartbeat. (env SKIPPER_HEARTBEAT_TIMEOUT) (default 1m30s)
  -h, --help                                    help for controller
      --host string                             The hostname the controller listens on. (env SKIPPER_HOST) (default "0.0.0.0")
      --hpa-downscale-stabilization duration    The stabilization window for downscaling in the HPA algorithm. (env SKIPPER_HPA_DOWNSCALE_STABILIZATION) (default 1m30s)
      --hpa-initial-readiness-delay duration    The initial readiness delay for the HPA algorithm. (env SKIPPER_HPA_INITIAL_READINESS_DELAY) (default 30s)
      --hpa-tolerance float                     The usage ratio tolerance for the HPA algorithm. (env SKIPPER_HPA_TOLERANCE) (default 0.1)
      --kubeconfig-burst int                    The burst for the kubeconfig client. (env SKIPPER_KUBECONFIG_BURST) (default 200)
      --kubeconfig-qps float                    The QPS for the kubeconfig client. (env SKIPPER_KUBECONFIG_QPS) (default 100)
      --log-format string                       The log format to use. (json, text) (env SKIPPER_LOG_FORMAT) (default "json")
      --log-level                               The log level to use. (trace, debug, info, warn, error) (env SKIPPER_LOG_LEVEL) (default INFO)
      --max-concurrent-stale-replacements int   Maximum number of stale instances that can be replaced concurrently. (env SKIPPER_MAX_CONCURRENT_STALE_REPLACEMENTS) (default 10)
      --namespace string                        The namespace the controller is in. (env SKIPPER_NAMESPACE)
      --paseto-private-key                      The private key used to sign PASETO tokens for assigned pods. (env SKIPPER_PASETO_PRIVATE_KEY) (default ********)
      --pod-ip string                           The pod IP the controller is running on. (env SKIPPER_POD_IP)
      --port int                                The port the server listens on. (env SKIPPER_PORT) (default 50051)
      --pprof                                   Whether to enable pprof. (env SKIPPER_PPROF) (default true)
      --pprof-host string                       The host to serve the pprof on. (env SKIPPER_PPROF_HOST) (default "0.0.0.0")
      --pprof-port int                          The port to serve the pprof on. (env SKIPPER_PPROF_PORT) (default 6060)
      --pprof-shutdown-timeout duration         The timeout for shutting down the pprof. (env SKIPPER_PPROF_SHUTDOWN_TIMEOUT) (default 5s)
      --scale-interval duration                 How often to scale functions. (env SKIPPER_SCALE_INTERVAL) (default 15s)
      --shutdown-timeout duration               The timeout for shutting down the controller. (env SKIPPER_SHUTDOWN_TIMEOUT) (default 5s)
      --skip-forbidden-namespaces               Whether to skip function namespaces that the service account does not have access to. (env SKIPPER_SKIP_FORBIDDEN_NAMESPACES)
      --telemetry                               Whether to enable OpenTelemetry. (env SKIPPER_TELEMETRY)
      --telemetry-metric                        Whether to enable metrics if telemetry is enabled. (env SKIPPER_TELEMETRY_METRIC) (default true)
      --telemetry-metric-otlp                   Whether to send metrics to the OTLP endpoint. (env SKIPPER_TELEMETRY_METRIC_OTLP)
      --telemetry-prometheus-host string        The host for the Prometheus metrics endpoint. (env SKIPPER_TELEMETRY_PROMETHEUS_HOST) (default "0.0.0.0")
      --telemetry-prometheus-port int           The port for the Prometheus metrics endpoint. (env SKIPPER_TELEMETRY_PROMETHEUS_PORT) (default 9090)
      --telemetry-shutdown-timeout duration     The timeout for shutting down the telemetry. (env SKIPPER_TELEMETRY_SHUTDOWN_TIMEOUT) (default 5s)
      --telemetry-trace                         Whether to enable tracing if telemetry is enabled. (env SKIPPER_TELEMETRY_TRACE) (default true)
