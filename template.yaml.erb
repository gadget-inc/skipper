<%-
image_repository ||= "fusion"
image_tag ||= "latest"
image_pull_policy ||= "IfNotPresent"

log_level ||= "info"
log_format ||= "text"

skip_forbidden_namespaces ||= false

replicas ||= 2
max_surge ||= "100%"
max_unavailable ||= "0"
request_cpu ||= "250m"
request_memory ||= "256Mi"
limit_cpu ||= request_cpu
limit_memory ||= request_memory
termination_grace_period_seconds ||= 30
pre_stop_sleep ||= 5
env ||= {}

controller_name = "#{namespace}-controller"
controller_log_level ||= log_level
controller_log_format ||= log_format
controller_image_repository ||= image_repository
controller_image_tag ||= image_tag
controller_image_pull_policy ||= image_pull_policy
controller_replicas ||= replicas
controller_max_surge ||= max_surge
controller_max_unavailable ||= max_unavailable
controller_request_cpu ||= request_cpu
controller_request_memory ||= request_memory
controller_limit_cpu ||= controller_request_cpu
controller_limit_memory ||= controller_request_memory
controller_termination_grace_period_seconds ||= termination_grace_period_seconds
controller_pre_stop_sleep ||= pre_stop_sleep
controller_env ||= {}

router_name = "#{namespace}-router"
router_log_level ||= log_level
router_log_format ||= log_format
router_image_repository ||= image_repository
router_image_tag ||= image_tag
router_image_pull_policy ||= image_pull_policy
router_replicas ||= replicas
router_max_surge ||= max_surge
router_max_unavailable ||= max_unavailable
router_request_cpu ||= request_cpu
router_request_memory ||= request_memory
router_limit_cpu ||= router_request_cpu
router_limit_memory ||= router_request_memory
router_termination_grace_period_seconds ||= termination_grace_period_seconds
router_pre_stop_sleep ||= pre_stop_sleep
router_env ||= {}
-%>
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: <%= controller_name %>
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: <%= controller_name %>
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: <%= controller_name %>
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: <%= controller_name %>
subjects:
  - kind: ServiceAccount
    name: <%= controller_name %>
    namespace: <%= namespace %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= controller_name %>
  labels:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  annotations:
    shipit.shopify.io/restart: "true"
spec:
  replicas: <%= controller_replicas %>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: <%= controller_max_surge %>
      maxUnavailable: <%= controller_max_unavailable %>
  selector:
    matchLabels:
      app.kubernetes.io/name: fusion
      app.kubernetes.io/component: controller
      app.kubernetes.io/instance: <%= namespace %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fusion
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: <%= namespace %>
    spec:
      serviceAccountName: <%= controller_name %>
      terminationGracePeriodSeconds: <%= controller_termination_grace_period_seconds %>
      containers:
        - name: controller
          image: <%= controller_image_repository %>:<%= controller_image_tag %>
          imagePullPolicy: <%= controller_image_pull_policy %>
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sh", "-c", "sleep <%= controller_pre_stop_sleep %>"]
          args:
            - controller
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: FUSION_CONTROLLER_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: FUSION_CONTROLLER_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: FUSION_LOG_LEVEL
              value: "<%= controller_log_level %>"
            - name: FUSION_LOG_FORMAT
              value: "<%= controller_log_format %>"
            - name: FUSION_FUNCTION_NAMESPACES
              value: "<%= function_namespaces.join(',') %>"
            - name: FUSION_SKIP_FORBIDDEN_NAMESPACES
              value: "<%= skip_forbidden_namespaces %>"
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- controller_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- if defined? unsafe_controller_paseto_private_key -%>
            - name: FUSION_CONTROLLER_PASETO_PRIVATE_KEY
              value: <%= unsafe_controller_paseto_private_key.to_json %>
            <%- else -%>
          envFrom:
            - secretRef:
                name: <%= controller_name %>
            <%- end -%>
          resources:
            requests:
              memory: "<%= controller_request_memory %>"
              cpu: "<%= controller_request_cpu %>"
            limits:
              memory: "<%= controller_limit_memory %>"
              cpu: "<%= controller_limit_cpu %>"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 2
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                      - fusion
                    - key: app.kubernetes.io/component
                      operator: In
                      values:
                      - controller
                    - key: app.kubernetes.io/instance
                      operator: In
                      values:
                      - <%= namespace %>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= controller_name %>
spec:
  selector:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - port: 80
      targetPort: http
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: <%= router_name %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= router_name %>
  labels:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: router
    app.kubernetes.io/instance: <%= namespace %>
  annotations:
    shipit.shopify.io/restart: "true"
spec:
  replicas: <%= router_replicas %>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: <%= router_max_surge %>
      maxUnavailable: <%= router_max_unavailable %>
  selector:
    matchLabels:
      app.kubernetes.io/name: fusion
      app.kubernetes.io/component: router
      app.kubernetes.io/instance: <%= namespace %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fusion
        app.kubernetes.io/component: router
        app.kubernetes.io/instance: <%= namespace %>
    spec:
      serviceAccountName: <%= router_name %>
      terminationGracePeriodSeconds: <%= router_termination_grace_period_seconds %>
      containers:
        - name: router
          image: <%= router_image_repository %>:<%= router_image_tag %>
          imagePullPolicy: <%= router_image_pull_policy %>
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sh", "-c", "sleep <%= router_pre_stop_sleep %>"]
          args:
            - router
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: FUSION_LOG_LEVEL
              value: "<%= router_log_level %>"
            - name: FUSION_LOG_FORMAT
              value: "<%= router_log_format %>"
            - name: FUSION_CONTROLLER_SERVICE_HOST
              value: "<%= controller_name %>.<%= namespace %>.svc.cluster.local"
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- router_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
          resources:
            requests:
              cpu: "<%= router_request_cpu %>"
              memory: "<%= router_request_memory %>"
            limits:
              cpu: "<%= router_limit_cpu %>"
              memory: "<%= router_limit_memory %>"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 2
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                      - fusion
                    - key: app.kubernetes.io/instance
                      operator: In
                      values:
                      - <%= namespace %>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= router_name %>
spec:
  <%- if defined? router_node_port -%>
  type: NodePort
  <%- end -%>
  selector:
    app.kubernetes.io/name: fusion
    app.kubernetes.io/component: router
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - port: 80
      targetPort: http
      <%- if defined? router_node_port -%>
      nodePort: <%= router_node_port %>
      <%- end -%>
