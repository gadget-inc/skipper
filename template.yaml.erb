# THIS IS A COPY/PASTED FILE! DO NOT EDIT MANUALLY!
#
# All configuration changes should be made via config/values.yaml
#
# This file was copied from https://github.com/gadget-inc/skipper/blob/main/template.yaml.erb
# We manually copy over new versions when we update skipper.
<%-
image_registry ||= ""
image_name ||= "skipper"
image_tag ||= "latest"
image_digest ||= ""
image_pull_policy ||= "IfNotPresent"

log_level ||= "info"
log_format ||= "text"

skip_forbidden_namespaces ||= false

replicas ||= 2
max_surge ||= "100%"
max_unavailable ||= "0"
request_cpu ||= "250m"
request_memory ||= "256Mi"
limit_cpu ||= request_cpu
limit_memory ||= request_memory
pre_stop_sleep ||= 20
shutdown_timeout_seconds ||= 5
env ||= {}
annotations ||= {}

controller_name = "#{namespace}-controller"
controller_log_level ||= log_level
controller_log_format ||= log_format
controller_image_registry ||= image_registry
controller_image_name ||= image_name
controller_image_tag ||= image_tag
controller_image_digest ||= image_digest
controller_image_pull_policy ||= image_pull_policy
controller_replicas ||= replicas
controller_max_surge ||= max_surge
controller_max_unavailable ||= max_unavailable
controller_request_cpu ||= request_cpu
controller_request_memory ||= request_memory
controller_limit_cpu ||= controller_request_cpu
controller_limit_memory ||= controller_request_memory
controller_pre_stop_sleep ||= pre_stop_sleep
controller_shutdown_timeout_seconds ||= shutdown_timeout_seconds
controller_termination_grace_period_seconds ||= controller_pre_stop_sleep + controller_shutdown_timeout_seconds + 5
controller_env ||= {}
controller_annotations ||= {}

controller_image = ""
unless controller_image_registry.empty?
  controller_image += "#{controller_image_registry}/"
end

controller_image += "#{controller_image_name}:#{controller_image_tag}"
if controller_image_digest
  controller_image += "@#{controller_image_digest}"
end


router_name = "#{namespace}-router"
router_log_level ||= log_level
router_log_format ||= log_format
router_image_registry ||= image_registry
router_image_name ||= image_name
router_image_tag ||= image_tag
router_image_digest ||= image_digest
router_image_pull_policy ||= image_pull_policy
router_replicas ||= replicas
router_min_replicas ||= replicas
router_max_replicas ||= replicas
router_max_surge ||= max_surge
router_max_unavailable ||= max_unavailable
router_request_cpu ||= request_cpu
router_request_memory ||= request_memory
router_limit_cpu ||= router_request_cpu
router_limit_memory ||= router_request_memory
router_pre_stop_sleep ||= pre_stop_sleep
router_shutdown_timeout_seconds ||= shutdown_timeout_seconds
router_termination_grace_period_seconds ||= router_pre_stop_sleep + router_shutdown_timeout_seconds + 5
router_env ||= {}
router_annotations ||= {}

router_image = ""
unless router_image_registry.empty?
  router_image += "#{router_image_registry}/"
end

router_image += "#{router_image_name}:#{router_image_tag}"
if router_image_digest
  router_image += "@#{router_image_digest}"
end
-%>
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: <%= controller_name %>
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: <%= controller_name %>
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: <%= controller_name %>
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: <%= controller_name %>
subjects:
  - kind: ServiceAccount
    name: <%= controller_name %>
    namespace: <%= namespace %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= controller_name %>
  labels:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  <%- if annotations.any? || controller_annotations.any? -%>
  annotations:
    <%- annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
    <%- controller_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
  <%- end -%>
spec:
  replicas: <%= controller_replicas %>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: <%= controller_max_surge %>
      maxUnavailable: <%= controller_max_unavailable %>
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: controller
      app.kubernetes.io/instance: <%= namespace %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: skipper
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: <%= namespace %>
      <%- if annotations.any? || controller_annotations.any? -%>
      annotations:
        <%- annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
        <%- controller_annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
      <%- end -%>
    spec:
      serviceAccountName: <%= controller_name %>
      terminationGracePeriodSeconds: <%= controller_termination_grace_period_seconds %>
      containers:
        - name: controller
          image: <%= controller_image %>
          imagePullPolicy: <%= controller_image_pull_policy %>
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sh", "-c", "sleep <%= controller_pre_stop_sleep %>"]
          args:
            - controller
          ports:
            - name: http
              containerPort: 8080
            - name: metrics
              containerPort: 9090
          env:
            - name: SKIPPER_CONTROLLER_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: SKIPPER_CONTROLLER_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: SKIPPER_LOG_LEVEL
              value: "<%= controller_log_level %>"
            - name: SKIPPER_LOG_FORMAT
              value: "<%= controller_log_format %>"
            - name: SKIPPER_FUNCTION_NAMESPACES
              value: "<%= function_namespaces.join(',') %>"
            - name: SKIPPER_SKIP_FORBIDDEN_NAMESPACES
              value: "<%= skip_forbidden_namespaces %>"
            - name: SKIPPER_CONTROLLER_SHUTDOWN_TIMEOUT
              value: "<%= controller_shutdown_timeout_seconds %>s"
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- controller_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- if defined? unsafe_controller_paseto_private_key -%>
            - name: SKIPPER_CONTROLLER_PASETO_PRIVATE_KEY
              value: <%= unsafe_controller_paseto_private_key.to_json %>
            <%- else -%>
          envFrom:
            - secretRef:
                name: <%= controller_name %>
            <%- end -%>
          resources:
            requests:
              memory: "<%= controller_request_memory %>"
              cpu: "<%= controller_request_cpu %>"
            limits:
              memory: "<%= controller_limit_memory %>"
              cpu: "<%= controller_limit_cpu %>"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 2
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                      - skipper
                    - key: app.kubernetes.io/component
                      operator: In
                      values:
                      - controller
                    - key: app.kubernetes.io/instance
                      operator: In
                      values:
                      - <%= namespace %>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= controller_name %>
spec:
  selector:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - port: 80
      targetPort: http
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: <%= controller_name %>-pdb
spec:
  minAvailable: <%= controller_replicas - 1 %>
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: controller
      app.kubernetes.io/instance: <%= namespace %>
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: <%= router_name %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= router_name %>
  labels:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: router
    app.kubernetes.io/instance: <%= namespace %>
  <%- if annotations.any? || router_annotations.any? -%>
  annotations:
    <%- annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
    <%- router_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
  <%- end -%>
spec:
  <%- if router_min_replicas == router_max_replicas -%>
  replicas: <%= router_replicas %>
  <%- end -%>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: <%= router_max_surge %>
      maxUnavailable: <%= router_max_unavailable %>
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: router
      app.kubernetes.io/instance: <%= namespace %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: skipper
        app.kubernetes.io/component: router
        app.kubernetes.io/instance: <%= namespace %>
      <%- if annotations.any? || router_annotations.any? -%>
      annotations:
        <%- annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
        <%- router_annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
      <%- end -%>
    spec:
      serviceAccountName: <%= router_name %>
      terminationGracePeriodSeconds: <%= router_termination_grace_period_seconds %>
      containers:
        - name: router
          image: <%= router_image %>
          imagePullPolicy: <%= router_image_pull_policy %>
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sh", "-c", "sleep <%= router_pre_stop_sleep %>"]
          args:
            - router
          ports:
            - name: http
              containerPort: 8080
            - name: metrics
              containerPort: 9090
          env:
            - name: SKIPPER_ROUTER_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: SKIPPER_LOG_LEVEL
              value: "<%= router_log_level %>"
            - name: SKIPPER_LOG_FORMAT
              value: "<%= router_log_format %>"
            - name: SKIPPER_CONTROLLER_SERVICE_HOST
              value: "<%= controller_name %>.<%= namespace %>.svc.cluster.local"
            - name: SKIPPER_ROUTER_SHUTDOWN_TIMEOUT
              value: "<%= router_shutdown_timeout_seconds %>s"
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- router_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
          resources:
            requests:
              cpu: "<%= router_request_cpu %>"
              memory: "<%= router_request_memory %>"
            limits:
              cpu: "<%= router_limit_cpu %>"
              memory: "<%= router_limit_memory %>"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 2
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                      - skipper
                    - key: app.kubernetes.io/instance
                      operator: In
                      values:
                      - <%= namespace %>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= router_name %>
spec:
  <%- if defined? router_node_port -%>
  type: NodePort
  <%- end -%>
  selector:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: router
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - port: 80
      targetPort: http
      <%- if defined? router_node_port -%>
      nodePort: <%= router_node_port %>
      <%- end -%>
<%- if router_min_replicas != router_max_replicas -%>
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: <%= router_name %>-autoscaler
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: <%= router_name %>
  minReplicas: <%= router_min_replicas %>
  maxReplicas: <%= router_max_replicas %>
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 90
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 90
<%- end -%>
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: <%= router_name %>-pdb
spec:
  minAvailable: <%= router_min_replicas - 1 %>
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: router
      app.kubernetes.io/instance: <%= namespace %>
