<%-
image_registry ||= ""
image_tag ||= "latest"
image_digest ||= ""
image_pull_policy ||= "IfNotPresent"

log_level ||= "info"
log_format ||= "text"

skip_forbidden_namespaces ||= false

replicas ||= 2
max_surge ||= "100%"
max_unavailable ||= "0"
request_cpu ||= "250m"
request_memory ||= "256Mi"
pre_stop_sleep ||= 20
shutdown_timeout_seconds ||= 5
env ||= {}
annotations ||= {}
node_selector ||= {}
tolerations ||= []
affinity ||= {}
topology_spread_constraints ||= {}
service_annotations ||= {}
service_spec ||= {}

controller_name = "#{namespace}-controller"
controller_port ||= 50051
controller_web_port ||= 8080
controller_log_level ||= log_level
controller_log_format ||= log_format
controller_image_registry ||= image_registry
controller_image_name ||= "skipper-controller"
controller_image_tag ||= image_tag
controller_image_digest ||= image_digest
controller_image_pull_policy ||= image_pull_policy
controller_replicas ||= replicas
controller_min_replicas ||= replicas
controller_max_replicas ||= replicas
controller_max_surge ||= max_surge
controller_max_unavailable ||= max_unavailable
controller_request_cpu ||= request_cpu
controller_request_memory ||= request_memory
controller_limit_cpu ||= ""
controller_limit_memory ||= controller_request_memory
controller_pre_stop_sleep ||= pre_stop_sleep
controller_shutdown_timeout_seconds ||= shutdown_timeout_seconds
controller_termination_grace_period_seconds ||= controller_pre_stop_sleep + controller_shutdown_timeout_seconds + 5
controller_env ||= {}
controller_annotations ||= {}
controller_node_selector ||= node_selector
controller_tolerations ||= []
controller_affinity ||= affinity
controller_topology_spread_constraints ||= topology_spread_constraints
controller_service_annotations ||= {}
controller_service_spec ||= {}
controller_web_template_host_dir ||= ""

controller_image = ""
if controller_image_registry.present?
  controller_image += "#{controller_image_registry}/"
end

controller_image += controller_image_name

if controller_image_tag.present?
  controller_image += ":#{controller_image_tag}"
end

if controller_image_digest.present?
  controller_image += "@#{controller_image_digest}"
end

router_name = "#{namespace}-router"
router_log_level ||= log_level
router_log_format ||= log_format
router_image_registry ||= image_registry
router_image_name ||= "skipper-router"
router_image_tag ||= image_tag
router_image_digest ||= image_digest
router_image_pull_policy ||= image_pull_policy
router_replicas ||= replicas
router_min_replicas ||= replicas
router_max_replicas ||= replicas
router_max_surge ||= max_surge
router_max_unavailable ||= max_unavailable
router_request_cpu ||= request_cpu
router_request_memory ||= request_memory
router_limit_cpu ||= ""
router_limit_memory ||= router_request_memory
router_pre_stop_sleep ||= pre_stop_sleep
router_shutdown_timeout_seconds ||= shutdown_timeout_seconds
router_termination_grace_period_seconds ||= router_pre_stop_sleep + router_shutdown_timeout_seconds + 5
router_env ||= {}
router_annotations ||= {}
router_node_selector ||= node_selector
router_tolerations ||= []
router_affinity ||= affinity
router_topology_spread_constraints ||= topology_spread_constraints
router_service_annotations ||= {}
router_service_spec ||= {}
router_controller_port ||= controller_port

router_image = ""
if router_image_registry.present?
  router_image += "#{router_image_registry}/"
end

router_image += router_image_name

if router_image_tag.present?
  router_image += ":#{router_image_tag}"
end

if router_image_digest.present?
  router_image += "@#{router_image_digest}"
end

def to_yaml(object, indentation: 0)
  object.to_yaml.delete_prefix!("---\n").gsub(/\n/, "\n" + " " * indentation)
end
-%>
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: <%= controller_name %>
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: <%= controller_name %>
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: <%= controller_name %>
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: <%= controller_name %>
subjects:
  - kind: ServiceAccount
    name: <%= controller_name %>
    namespace: <%= namespace %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= controller_name %>
  labels:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  <%- if annotations.any? || controller_annotations.any? -%>
  annotations:
    <%- annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
    <%- controller_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
  <%- end -%>
spec:
  <%- if controller_min_replicas == controller_max_replicas -%>
  replicas: <%= controller_replicas %>
  <%- end -%>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: <%= controller_max_surge %>
      maxUnavailable: <%= controller_max_unavailable %>
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: controller
      app.kubernetes.io/instance: <%= namespace %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: skipper
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: <%= namespace %>
      <%- if annotations.any? || controller_annotations.any? -%>
      annotations:
        <%- annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
        <%- controller_annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
      <%- end -%>
    spec:
      serviceAccountName: <%= controller_name %>
      terminationGracePeriodSeconds: <%= controller_termination_grace_period_seconds %>
      containers:
        - name: controller
          image: <%= controller_image %>
          imagePullPolicy: <%= controller_image_pull_policy %>
          securityContext:
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sh", "-c", "sleep <%= controller_pre_stop_sleep %>"]
          ports:
            - name: pprof
              containerPort: 6060
            - name: grpc
              containerPort: <%= controller_port %>
            - name: web
              containerPort: <%= controller_web_port %>
              protocol: TCP
            - name: metrics
              containerPort: 9090
          env:
            - name: K8S_POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: K8S_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: K8S_NAMESPACE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: K8S_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: k8s.pod.name=$(K8S_POD_NAME),k8s.pod.ip=$(K8S_POD_IP),k8s.namespace.name=$(K8S_NAMESPACE_NAME),k8s.node.name=$(K8S_NODE_NAME)
            - name: SKIPPER_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: SKIPPER_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: SKIPPER_LOG_LEVEL
              value: "<%= controller_log_level %>"
            - name: SKIPPER_LOG_FORMAT
              value: "<%= controller_log_format %>"
            - name: SKIPPER_FUNCTION_NAMESPACES
              value: "<%= function_namespaces.join(',') %>"
            - name: SKIPPER_SKIP_FORBIDDEN_NAMESPACES
              value: "<%= skip_forbidden_namespaces %>"
            - name: SKIPPER_SHUTDOWN_TIMEOUT
              value: "<%= controller_shutdown_timeout_seconds %>s"
            - name: SKIPPER_PORT
              value: "<%= controller_port %>"
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- controller_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- if controller_web_template_host_dir.present? -%>
            - name: SKIPPER_WEB_TEMPLATE_DIR
              value: "/web-templates"
            <%- end -%>
            <%- if defined? unsafe_controller_paseto_private_key -%>
            - name: SKIPPER_PASETO_PRIVATE_KEY
              value: <%= unsafe_controller_paseto_private_key.to_json %>
            <%- else -%>
          envFrom:
            - secretRef:
                name: <%= controller_name %>
            <%- end -%>
          <%- if controller_web_template_host_dir.present? -%>
          volumeMounts:
            - name: web-templates
              mountPath: /web-templates
              readOnly: true
          <%- end -%>
          resources:
            requests:
              memory: "<%= controller_request_memory %>"
              cpu: "<%= controller_request_cpu %>"
            limits:
              memory: "<%= controller_limit_memory %>"
              <%- if controller_limit_cpu.present? -%>
              cpu: "<%= controller_limit_cpu %>"
              <%- end -%>
          startupProbe:
            grpc:
              port: <%= controller_port %>
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            grpc:
              port: <%= controller_port %>
            failureThreshold: 2
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            grpc:
              port: <%= controller_port %>
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
      <%- if controller_node_selector.any? -%>
      nodeSelector:
        <%= to_yaml(controller_node_selector, indentation: 8) %>
      <%- end -%>
      <%- if tolerations.any? || controller_tolerations.any? -%>
      tolerations:
        <%- tolerations.each do |toleration| -%>
        - <%= to_yaml(toleration, indentation: 10) %>
        <%- end -%>
        <%- controller_tolerations.each do |toleration| -%>
        - <%= to_yaml(toleration, indentation: 10) %>
        <%- end -%>
      <%- end -%>
      <%- if controller_affinity.any? -%>
      affinity:
        <%= to_yaml(controller_affinity, indentation: 8) %>
      <%- else -%>
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: skipper
                    app.kubernetes.io/component: controller
                    app.kubernetes.io/instance: <%= namespace %>
      <%- end -%>
      topologySpreadConstraints:
        - topologyKey: kubernetes.io/hostname
          maxSkew: 1
          whenUnsatisfiable: <%= controller_topology_spread_constraints["kubernetes.io/hostname"] || "ScheduleAnyway" %>
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: skipper
              app.kubernetes.io/component: controller
              app.kubernetes.io/instance: <%= namespace %>
        - topologyKey: topology.kubernetes.io/zone
          maxSkew: 1
          whenUnsatisfiable: <%= controller_topology_spread_constraints["topology.kubernetes.io/zone"] || "ScheduleAnyway" %>
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: skipper
              app.kubernetes.io/component: controller
              app.kubernetes.io/instance: <%= namespace %>
      <%- if controller_web_template_host_dir.present? -%>
      volumes:
        - name: web-templates
          hostPath:
            path: "<%= controller_web_template_host_dir %>"
            type: Directory
      <%- end -%>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= controller_name %>
  <%- if service_annotations.any? || controller_service_annotations.any? -%>
  annotations:
    <%- service_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
    <%- controller_service_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
  <%- end -%>
spec:
  <%- if defined? controller_node_port or defined? controller_web_node_port -%>
  type: NodePort
  <%- end -%>
  selector:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - name: grpc
      port: <%= controller_port %>
      targetPort: grpc
      protocol: TCP
  <%- if defined? controller_node_port -%>
      nodePort: <%= controller_node_port %>
  <%- end -%>
    - name: web
      port: <%= controller_web_port %>
      targetPort: web
      protocol: TCP
  <%- if defined? controller_web_node_port -%>
      nodePort: <%= controller_web_node_port %>
  <%- end -%>
  <%- if service_spec.any? -%>
  <%= to_yaml(service_spec, indentation: 2) %>
  <%- end -%>
  <%- if controller_service_spec.any? -%>
  <%= to_yaml(controller_service_spec, indentation: 2) %>
  <%- end -%>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= controller_name %>-headless
spec:
  clusterIP: None
  selector:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - name: grpc
      port: <%= controller_port %>
      targetPort: grpc
<%- if controller_min_replicas != controller_max_replicas -%>
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: <%= controller_name %>-autoscaler
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: <%= controller_name %>
  minReplicas: <%= controller_min_replicas %>
  maxReplicas: <%= controller_max_replicas %>
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 90
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 90
<%- end -%>
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: <%= controller_name %>-pdb
spec:
  maxUnavailable: 1
  unhealthyPodEvictionPolicy: AlwaysAllow
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: controller
      app.kubernetes.io/instance: <%= namespace %>
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: <%= router_name %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= router_name %>
  labels:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: router
    app.kubernetes.io/instance: <%= namespace %>
  <%- if annotations.any? || router_annotations.any? -%>
  annotations:
    <%- annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
    <%- router_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
  <%- end -%>
spec:
  <%- if router_min_replicas == router_max_replicas -%>
  replicas: <%= router_replicas %>
  <%- end -%>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: <%= router_max_surge %>
      maxUnavailable: <%= router_max_unavailable %>
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: router
      app.kubernetes.io/instance: <%= namespace %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: skipper
        app.kubernetes.io/component: router
        app.kubernetes.io/instance: <%= namespace %>
      <%- if annotations.any? || router_annotations.any? -%>
      annotations:
        <%- annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
        <%- router_annotations.each do |key, value| -%>
        <%= key %>: "<%= value %>"
        <%- end -%>
      <%- end -%>
    spec:
      serviceAccountName: <%= router_name %>
      terminationGracePeriodSeconds: <%= router_termination_grace_period_seconds %>
      containers:
        - name: router
          image: <%= router_image %>
          imagePullPolicy: <%= router_image_pull_policy %>
          securityContext:
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          lifecycle:
            preStop:
              exec:
                command: ["/bin/sh", "-c", "sleep <%= router_pre_stop_sleep %>"]
          ports:
            - name: pprof
              containerPort: 6060
            - name: http
              containerPort: 8080
            - name: metrics
              containerPort: 9090
          env:
            - name: K8S_POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: K8S_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: K8S_NAMESPACE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: K8S_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: k8s.pod.name=$(K8S_POD_NAME),k8s.pod.ip=$(K8S_POD_IP),k8s.namespace.name=$(K8S_NAMESPACE_NAME),k8s.node.name=$(K8S_NODE_NAME)
            - name: SKIPPER_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: SKIPPER_LOG_LEVEL
              value: "<%= router_log_level %>"
            - name: SKIPPER_LOG_FORMAT
              value: "<%= router_log_format %>"
            - name: SKIPPER_CONTROLLER_SERVICE_HOST
              value: "<%= controller_name %>.<%= namespace %>.svc.cluster.local"
            - name: SKIPPER_CONTROLLER_PORT
              value: "<%= router_controller_port %>"
            - name: SKIPPER_CONTROLLER_HEADLESS_SERVICE_HOST
              value: "<%= controller_name %>-headless.<%= namespace %>.svc.cluster.local"
            - name: SKIPPER_SHUTDOWN_TIMEOUT
              value: "<%= router_shutdown_timeout_seconds %>s"
            <%- env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
            <%- router_env.each do |key, value| -%>
            - name: "<%= key %>"
              value: "<%= value %>"
            <%- end -%>
          resources:
            requests:
              cpu: "<%= router_request_cpu %>"
              memory: "<%= router_request_memory %>"
            limits:
              <%- if router_limit_cpu.present? -%>
              cpu: "<%= router_limit_cpu %>"
              <%- end -%>
              memory: "<%= router_limit_memory %>"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 3
            initialDelaySeconds: 3
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 2
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 1
            periodSeconds: 1
            successThreshold: 1
            timeoutSeconds: 1
      <%- if router_node_selector.any? -%>
      nodeSelector:
        <%= to_yaml(router_node_selector, indentation: 8) %>
      <%- end -%>
      <%- if tolerations.any? || router_tolerations.any? -%>
      tolerations:
        <%- tolerations.each do |toleration| -%>
        - <%= to_yaml(toleration, indentation: 10) %>
        <%- end -%>
        <%- router_tolerations.each do |toleration| -%>
        - <%= to_yaml(toleration, indentation: 10) %>
        <%- end -%>
      <%- end -%>
      <%- if router_affinity.any? -%>
      affinity:
        <%= to_yaml(router_affinity, indentation: 8) %>
      <%- else -%>
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: skipper
                    app.kubernetes.io/component: router
                    app.kubernetes.io/instance: <%= namespace %>
      <%- end -%>
      topologySpreadConstraints:
        - topologyKey: kubernetes.io/hostname
          maxSkew: 1
          whenUnsatisfiable: <%= router_topology_spread_constraints["kubernetes.io/hostname"] || "ScheduleAnyway" %>
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: skipper
              app.kubernetes.io/component: router
              app.kubernetes.io/instance: <%= namespace %>
        - topologyKey: topology.kubernetes.io/zone
          maxSkew: 1
          whenUnsatisfiable: <%= router_topology_spread_constraints["topology.kubernetes.io/zone"] || "ScheduleAnyway" %>
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: skipper
              app.kubernetes.io/component: router
              app.kubernetes.io/instance: <%= namespace %>
---
apiVersion: v1
kind: Service
metadata:
  name: <%= router_name %>
  <%- if service_annotations.any? || router_service_annotations.any? -%>
  annotations:
    <%- service_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
    <%- router_service_annotations.each do |key, value| -%>
    <%= key %>: "<%= value %>"
    <%- end -%>
  <%- end -%>
spec:
  <%- if defined? router_node_port -%>
  type: NodePort
  <%- end -%>
  selector:
    app.kubernetes.io/name: skipper
    app.kubernetes.io/component: router
    app.kubernetes.io/instance: <%= namespace %>
  ports:
    - port: 80
      targetPort: http
      <%- if defined? router_node_port -%>
      nodePort: <%= router_node_port %>
      <%- end -%>
  <%- if service_spec.any? -%>
  <%= to_yaml(service_spec, indentation: 2) %>
  <%- end -%>
  <%- if router_service_spec.any? -%>
  <%= to_yaml(router_service_spec, indentation: 2) %>
  <%- end -%>
<%- if router_min_replicas != router_max_replicas -%>
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: <%= router_name %>-autoscaler
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: <%= router_name %>
  minReplicas: <%= router_min_replicas %>
  maxReplicas: <%= router_max_replicas %>
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 90
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 90
<%- end -%>
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: <%= router_name %>-pdb
spec:
  maxUnavailable: 1
  unhealthyPodEvictionPolicy: AlwaysAllow
  selector:
    matchLabels:
      app.kubernetes.io/name: skipper
      app.kubernetes.io/component: router
      app.kubernetes.io/instance: <%= namespace %>
